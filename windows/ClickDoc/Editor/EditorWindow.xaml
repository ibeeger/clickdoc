<Window x:Class="ClickDoc.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClickDoc.Localization"
        Title="{l:L 编辑教程}"
        Icon="/Assets/ClickDoc.ico"
        Width="1100" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TitleBox" Grid.Column="1" Width="260" ToolTip="{l:L 教程标题}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RecordButton" MinWidth="110" Click="OnRecordClick" />
                <ContentControl x:Name="ExportSlot" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
        <Grid x:Name="Body">
            <TextBlock x:Name="EmptyHint"
                       Text="{l:L 还没有步骤。点上方的「开始录制」，或从任务栏右下角的托盘图标开始。}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Opacity="0.6" />
        </Grid>
    </DockPanel>
</Window>
